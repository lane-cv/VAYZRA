# syntax=docker/dockerfile:1.7
FROM golang:1.26.5-bookworm AS tools
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOBIN=/out go install github.com/restic/restic/cmd/restic@v0.19.1 \
    && CGO_ENABLED=0 GOBIN=/out go install filippo.io/age/cmd/age@v1.3.1 \
    && CGO_ENABLED=0 GOBIN=/out go install filippo.io/age/cmd/age-keygen@v1.3.1

FROM golang:1.26.5-bookworm AS backup-build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd cmd
COPY db db
COPY internal internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' \
      -o /out/happylearn-backup ./cmd/backup

FROM debian:12.12-slim AS runtime
ARG POSTGRESQL_CLIENT_VERSION=18.4-1.pgdg12+1
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install \
      --no-install-recommends -y ca-certificates curl gnupg \
    && curl --fail --location --proto '=https' --tlsv1.2 \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /tmp/postgresql.asc \
    && gpg --batch --dearmor --output /usr/share/keyrings/postgresql.gpg \
      /tmp/postgresql.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/postgresql.list \
    && apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install \
      --no-install-recommends -y \
      "postgresql-client-18=${POSTGRESQL_CLIENT_VERSION}" \
    && apt-get purge -y curl gnupg \
    && apt-get autoremove -y \
    && rm -f /tmp/postgresql.asc \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/lib/postgresql/18/bin/pg_dump --version \
      | grep -Eq '^pg_dump \(PostgreSQL\) 18\.4 ' \
    && /usr/lib/postgresql/18/bin/pg_restore --version \
      | grep -Eq '^pg_restore \(PostgreSQL\) 18\.4 '
RUN useradd --uid 10003 --gid 0 --no-create-home \
      --shell /usr/sbin/nologin happylearn-backup \
    && install -d -o 10003 -g 0 -m 0555 /app \
    && install -d -o 10003 -g 0 -m 0700 /work /state
COPY --from=tools --chown=10003:0 /out/restic /usr/local/bin/restic
COPY --from=tools --chown=10003:0 /out/age /usr/local/bin/age
COPY --from=tools --chown=10003:0 /out/age-keygen /usr/local/bin/age-keygen
COPY --from=backup-build --chown=10003:0 \
  /out/happylearn-backup /app/happylearn-backup
RUN chmod 0555 /app/happylearn-backup \
      /usr/local/bin/restic /usr/local/bin/age /usr/local/bin/age-keygen \
    && restic version | grep -Eq '^restic 0\.19\.1 ' \
    && age --version | grep -Eq '^v?1\.3\.1$' \
    && age-keygen --version | grep -Eq '^v?1\.3\.1$'
ENV PATH="/usr/lib/postgresql/18/bin:/usr/local/bin:/usr/bin:/bin"
WORKDIR /app
USER 10003:0
ENTRYPOINT ["/app/happylearn-backup"]
