[Unit]
Description=Submit one HappyLearn production host sample
After=happylearn-compose.service
Requires=happylearn-compose.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Group=@DEPLOY_GROUP@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/deploy/production.env
Environment=HOST_SAMPLER_BIN=/usr/local/libexec/happylearn/host-sampler
ExecStart=@TIMEOUT@ --foreground --kill-after=5s 45s @PROJECT_DIR@/scripts/collect-host-metrics.sh --environment production
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
ReadWritePaths=-/srv/happylearn -@PROJECT_DIR@/deploy/release-state
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
