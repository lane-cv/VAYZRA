{
  "name": "happylearn-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "pnpm --dir web test",
    "typecheck": "pnpm --dir web typecheck",
    "lint": "eslint web/src tests/e2e playwright.config.ts --max-warnings=0",
    "build": "pnpm --dir web build",
    "e2e-contracts": "make e2e-contracts",
    "e2e-phase4": "make e2e-phase4",
    "e2e-phase5": "make e2e-phase5",
    "backup:contract": "bash scripts/phase5-backup_contract_test.sh",
    "backup:live": "bash scripts/phase5-backup_live_test.sh",
    "backup:run": "make phase5-backup",
    "host-metrics:contract": "bash scripts/host-metrics_contract_test.sh",
    "host-metrics:live": "bash scripts/host-metrics_live_test.sh",
    "host-metrics:run": "make host-metrics"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.3.0",
    "typescript-eslint": "8.56.1",
    "vue-eslint-parser": "10.4.0"
  }
}
