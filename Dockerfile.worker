# syntax=docker/dockerfile:1.7
FROM golang:1.26.5-bookworm AS worker-build
ARG HAPPYLEARN_BUILD_VERSION
ARG HAPPYLEARN_BUILD_COMMIT
ARG HAPPYLEARN_BUILD_TIME
ARG HAPPYLEARN_BUILD_MIN_SCHEMA
ARG HAPPYLEARN_BUILD_MAX_SCHEMA
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd cmd
COPY db db
COPY internal internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOMAXPROCS=2 CGO_ENABLED=0 GOOS=linux go build -p=2 -trimpath \
      -ldflags="-s -w -X main.buildVersion=${HAPPYLEARN_BUILD_VERSION} -X main.buildCommit=${HAPPYLEARN_BUILD_COMMIT} -X main.buildTime=${HAPPYLEARN_BUILD_TIME} -X main.buildMinSchema=${HAPPYLEARN_BUILD_MIN_SCHEMA} -X main.buildMaxSchema=${HAPPYLEARN_BUILD_MAX_SCHEMA}" \
      -o /out/happylearn-worker ./cmd/worker \
    && GOMAXPROCS=2 CGO_ENABLED=0 GOOS=linux go build -p=2 -trimpath -ldflags='-s -w' -o /out/happylearn-maintenance ./cmd/maintenance

FROM debian:12.12-slim AS runtime
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get -o Acquire::Retries=5 update \
    && install_ok=0 \
    && for attempt in 1 2 3; do \
         if DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install --no-install-recommends -y \
           ca-certificates clamav clamav-freshclam curl ffmpeg libreoffice-calc libreoffice-core libreoffice-impress libreoffice-writer poppler-utils; then \
           install_ok=1; \
           break; \
         fi; \
         apt-get -o Acquire::Retries=5 update; \
       done \
    && test "$install_ok" -eq 1 \
    && signature_ok=0 \
    && for attempt in 1 2 3; do \
         if freshclam --stdout; then \
           signature_ok=1; \
           break; \
         fi; \
       done \
    && test "$signature_ok" -eq 1 \
    && clamscan --version \
    && rm -rf /var/lib/apt/lists/* /var/log/clamav/*
RUN groupadd --gid 10002 worker && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin worker \
    && install -d -o 10002 -g 10002 -m 0700 /work /app
WORKDIR /app
COPY --from=worker-build /out/happylearn-worker /app/happylearn-worker
COPY --from=worker-build /out/happylearn-maintenance /app/happylearn-maintenance
RUN chown 10002:10002 /app/happylearn-worker /app/happylearn-maintenance && chmod 0555 /app/happylearn-worker /app/happylearn-maintenance
USER 10002:10002
HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD ["curl", "--fail", "--silent", "http://127.0.0.1:8081/ready"]
ENTRYPOINT ["/app/happylearn-worker"]

FROM runtime AS worker
