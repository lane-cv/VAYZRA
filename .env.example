# Runtime environment: development or production.
HAPPYLEARN_ENV=development
# HTTP listen address.
HAPPYLEARN_LISTEN=:8080
# Required external service URLs. Supply environment-specific values locally.
HAPPYLEARN_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
HAPPYLEARN_REDIS_URL=redis://HOST:6379/0
# A unique, secret value used to HMAC login-throttling Redis keys.
HAPPYLEARN_LOGIN_THROTTLE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Public browser origin, without a trailing slash.
HAPPYLEARN_PUBLIC_ORIGIN=https://learn.example.com

# Optional comma-separated reverse-proxy CIDRs. Empty means direct connections.
HAPPYLEARN_TRUSTED_PROXY_CIDRS=

# Private MinIO object storage. Development ports bind to loopback only.
HAPPYLEARN_MINIO_ENDPOINT=127.0.0.1:59000
HAPPYLEARN_MINIO_ACCESS_KEY=happylearn_dev
HAPPYLEARN_MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_MINIO_SECRET
HAPPYLEARN_MINIO_USE_TLS=false
HAPPYLEARN_MINIO_ORIGINALS_BUCKET=happylearn-originals
HAPPYLEARN_MINIO_PREVIEWS_BUCKET=happylearn-previews
