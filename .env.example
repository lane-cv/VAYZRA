# Runtime environment: development or production.
HAPPYLEARN_ENV=development
# HTTP listen address.
HAPPYLEARN_LISTEN=:8080
# Required external service URLs. Supply environment-specific values locally.
HAPPYLEARN_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
HAPPYLEARN_REDIS_URL=redis://HOST:6379/0
# A unique, secret value used to HMAC login-throttling Redis keys.
HAPPYLEARN_LOGIN_THROTTLE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Public browser origin, without a trailing slash.
HAPPYLEARN_PUBLIC_ORIGIN=https://learn.example.com

# AI provider-secret encryption. Replace this non-working placeholder locally.
# Production requires standard base64 encoding of exactly 32 random bytes.
# Generate it directly into an owner-only file; see docs/runbooks/phase4-ai-qanda.md.
HAPPYLEARN_AI_MASTER_KEY=REPLACE_WITH_STANDARD_BASE64_OF_32_RANDOM_BYTES
HAPPYLEARN_AI_MASTER_KEY_VERSION=1
HAPPYLEARN_AI_BUSINESS_TIMEZONE=Asia/Shanghai
HAPPYLEARN_AI_GLOBAL_CONCURRENCY=2
HAPPYLEARN_AI_PER_STUDENT_CONCURRENCY=1
HAPPYLEARN_AI_ALLOW_PRIVATE_PROVIDER=false

# Optional comma-separated reverse-proxy CIDRs. Empty means direct connections.
HAPPYLEARN_TRUSTED_PROXY_CIDRS=

# Development Compose publishes AIStor on all host interfaces at port 59000.
# A host process uses 127.0.0.1:59000 to access that local published port; this is not a bind address.
# Download a MinIO AIStor Free license and keep it outside this repository.
# The path is resolved relative to deploy/compose.dev.yml and must exist before startup.
HAPPYLEARN_AISTOR_LICENSE_FILE=../secrets/minio.license
HAPPYLEARN_MINIO_ENDPOINT=127.0.0.1:59000
HAPPYLEARN_MINIO_ACCESS_KEY=happylearn_dev
HAPPYLEARN_MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_MINIO_SECRET
HAPPYLEARN_MINIO_USE_TLS=false
HAPPYLEARN_MINIO_ORIGINALS_BUCKET=happylearn-originals
HAPPYLEARN_MINIO_PREVIEWS_BUCKET=happylearn-previews
